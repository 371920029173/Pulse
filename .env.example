# === Pulse Agent Configuration ===
# Copy this file to `.env` and fill in your values.
# Do not commit `.env` — it may contain secrets.

# LLM (OpenAI-compatible)
SHE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# Optional Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Workspace (sandbox boundary). Prefer a project folder, not a personal Desktop path.
SHE_WORKSPACE=.

# Server
SHE_PORT=5577
SHE_HOST=127.0.0.1
SHE_ALLOWED_HOSTS=

# Knowledge base (relative to workspace unless absolute)
SHE_KB_PATH=.she/kb.sqlite

SHE_LOG_LEVEL=info
SHE_AUTOMATION_MODE=true
SHE_SKILL_PROFILE=general
SHE_THINKING_LEVEL=medium

# Permissions (safe defaults: confirm dangerous tools; deny destructive patterns)
#   SHE_ALLOW_ALL_COMMANDS=true is the same statement as the settings page's
#   "allow commands outside the workspace" checkbox + the「所有」tier: no confirmation tickets, no
#   destructive-pattern denial, no workspace boundary — AND no real isolation (see below), because
#   that tier means "run it on this machine". Setting it back to readonly/deny restores the boundary.
# SHE_ALLOW_ALL_COMMANDS=true

# Real isolation for shell commands (layer 4.2). Default: auto.
#   auto — run commands inside a WSL2 mount namespace when one is available, on the host otherwise;
#          every isolated result carries an `isolation` field, so a transcript never claims a
#          boundary that was not there.
#   wsl  — require the boundary: if WSL (or the node inside it) is unavailable the command is
#          REFUSED rather than run unconfined.
#   off  — never isolate. Use this if a workflow needs Windows tools (`powershell`, `cmd`,
#          `taskkill`, drive paths): inside the boundary the command is a LINUX process and the
#          only Windows path visible is the workspace itself.
# NOTE: SHE_ALLOW_ALL_COMMANDS=true (or the settings page's「所有」tier) overrides this switch —
# that tier asks for "run it on this machine", so isolation steps aside and every notice says so.
# SHE_SANDBOX_ISOLATION=auto
# SHE_WSL_DISTRO=            # empty uses WSL's own default distro

# Optional schedule working window, e.g. 09:00-18:00
# SHE_SCHEDULE_WINDOW=

# Web access for the agent (`web_search` / `web_fetch`). Default: auto.
#   off          — the two tools refuse and say which variable turns them back on. Nothing goes out.
#   auto         — try the key-free sources in order (DuckDuckGo light page -> Bing) and use the
#                  first that answers; each result names which source answered.
#   duckduckgo / bing — pin one key-free source (no silent fallback to the other).
#   tavily       — requires SHE_WEB_API_KEY (paid, cleaned snippets).
#   searxng      — requires SHE_WEB_BASE_URL (your own instance; a LAN address is fine here).
# Every call sends the query (or the URL) to that third party, so this is the switch a user holds.
# SHE_WEB_PROVIDER=auto
# SHE_WEB_API_KEY=           # only for SHE_WEB_PROVIDER=tavily
# SHE_WEB_BASE_URL=          # only for SHE_WEB_PROVIDER=searxng
# SHE_WEB_MAX_RESULTS=5      # hits per search
# SHE_WEB_TIMEOUT_MS=15000   # per request; a source that times out is not retried for 10 minutes
